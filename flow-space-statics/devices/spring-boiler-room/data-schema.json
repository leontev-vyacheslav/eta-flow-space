              },
              "editorOptions": {
                "readOnly": true,
                "valueExpr": "id",
                "displayExpr": "description"
              }
            },
            "colorizer": {
              "styleProps": [
                {}
              ]
            }
          }
        },
        "mode": {
          "$ref": "#/$defs/NetworkPumpMode",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxSelectBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Режим управления сетевым насосом"
              },
              "editorOptions": {
                "readOnly": true,
                "valueExpr": "id",
                "displayExpr": "description"
              }
            },
            "colorizer": {
              "styleProps": [
                {}
              ]
            }
          }
        },
        "isDryRun": {
          "type": "boolean",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Сухой ход"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "red": true,
                    "white": false
                  }
                }
              ]
            }
          }
        },
        "isAlarm": {
          "type": "boolean",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария"
              },
              "editorOptions": {
                "readOnly": true
              }
