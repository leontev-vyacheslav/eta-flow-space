{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateModel",
  "type": "object",
  "properties": {
    "isConnected": {
      "type": "boolean",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxCheckBox",
          "editorOptions": {
            "type": "boolean",
            "readOnly": true
          },
          "label": {
            "location": "left",
            "showColon": true,
            "text": "На связи"
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": false,
                "white": true
              },
              "stroke": {
                "yellow": false,
                "black": true
              }
            }
          ]
        }
      }
    },
    "tempOutAir": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура наружная"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressGas": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление газа"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "tempInNet": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура на обратке сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressInNet": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление на обратке сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "tempOutNet": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура на подаче сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressOutNet": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление на подаче сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressOutSrcW": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление исходной воды"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "isSourceWaterRelay": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Реле давления исходной воды"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isCO": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Загазованность CO"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isCH": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Загазованность CH"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
     "isSecurityAlarm": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Охранная сигнализация"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isFireAlarm": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Пожарная сигнализация"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isGasFlap": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Клапан отсекатель газа закрыт"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "sourceWaterPumps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceWaterPumpModel"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "boilers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoilerModel"
      },
      "minItems": 4,
      "maxItems": 4
    },

    "boilerPumps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoilerPumpModel"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "networkPumps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetworkPumpModel"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "timestamp": {
      "type": "integer",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxDateBox",
          "editorOptions": {
            "type": "datetime",
            "displayFormat": "dd.MM.yyyy HH:mm:ss",
            "readOnly": true
          },
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Время опроса"
          }
        }
      }
    }
  },
  "required": [
    "isConnected",
    "tempOutAir",
    "pressGas",
    "tempInNet",
    "pressInNet",
    "tempOutNet",
    "pressOutNet",
    "pressOutSrcW",
    "statusTempRoomAirSensor",
    "statusTempOutSensor",
    "statusPressGasSensor",
    "statusTempInNetSensor",
    "statusPressInNetSensor",
    "statusTempOutNetSensor",
    "statusPressOutNetSensor",
    "statusPressOutSrcWSensor",
    "isSourceWaterRelay",
    "isCO",
    "isCH",
    "isFireAlarm",
    "isSecurityAlarm",
    "isGasFlap",
    "sourceWaterPumps",
    "boilers",
    "boilerOutputValves",
    "boilerPumps",
    "networkPumps"
  ],
  "$defs": {
    "BoilerState": {
      "type": "integer",
      "enum": [
        1,
        2,
        4,
        8,
        16,
        32,
        64,
        128
      ],
      "enumDescriptions": {
        "1": "NOT_READY - Нет готовности",
        "2": "STOPPED - Отключен",
        "4": "STARTING - Включается",
        "8": "OPERATION_STAGE1 - Работа (на 1 ступени)",
        "16": "OPERATION_STAGE2 - Работа (на 2 ступени)",
        "32": "HOT_RESERVE - В горячем резерве",
        "64": "STOPPING - Останавливается",
        "128": "ALARM - Авария"
      }
    },
    "BoilerPumpState": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "enumDescriptions": {
        "1": "OPERATING - Работа",
        "2": "ALARM - Авария",
        "3": "STOP - Останов"
      }
    },
    "NetworkPumpState": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "enumDescriptions": {
        "0": "STOP - Останов",
        "1": "WORKING - Работа"
      }
    },
     "NetworkPumpStatus": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "enumDescriptions": {
        "0": "RESERVED - Резервный",
        "1": "MAIN - Ocновной"
      }
    },
     "NetworkPumpMode": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "enumDescriptions": {
        "0": "MANUAL - Ручной",
        "1": "AUTO - Автоматический"
      }
    },
    "SourceWaterPumpModel": {
      "type": "object",
      "properties": {
        "isWorking": {
          "type": "boolean",
          "ui": {
            "group": 4,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Работа насоса исходной воды"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "#00FF00": true,
                    "white": false
                  }
                }
              ]
            }
          }
        },
        "isAlarm": {
          "type": "boolean",
          "ui": {
            "group": 4,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария насоса исходной воды"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "stroke-width": {
                    "1": false,
                    "2  ": true
                  }
                },
                {
                  "stroke": {
                    "red": true,
                    "#000000": false
                  }
                }
              ]
            }
          }
        }
      }
    },
    "BoilerModel": {
      "type": "object",
      "properties": {
        "isBurnerFailure": {
          "type": "boolean",
          "ui": {
            "group": 2,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария горелки"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "stroke": {
                    "red": true,
                    "#000000": false
                  }
                }
              ]
            }
          }
        },
        "isWorking": {
          "type": "boolean",
          "ui": {
            "group": 2,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Работа котла"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "#00FF00": true,
                    "white": false
                  }
                }
              ]
            }
          }
        }
      },
      "required": [
        "state",
        "tempOut",
        "tempFlueGases",
        "isBurnerFailure",
        "isWorking",
        "isGasRelayPressure",
        "isMinWaterPressure",
        "isMaxWaterPressure",
        "isMaxWaterTemperature",
        "isFlowRelay",
        "statusTempOutSensor",
        "statusTempFlueGasesSensor"
      ]
    },
    "BoilerPumpModel": {
      "type": "object",
      "properties": {
        "isFailure": {
          "type": "boolean",
          "ui": {
            "group": 5,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария насоса котла"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "stroke-width": {
                    "1": false,
                    "2  ": true
                  }
                },
                {
                  "stroke": {
                    "red": true,
                    "blue": false
                  }
                }
              ]
            }
          }
        }
      },
      "required": [
        "isFailure"
      ]
    },
    "NetworkPumpModel": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/NetworkPumpState",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxSelectBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Состояние сетевого насоса"
              },
              "editorOptions": {
                "readOnly": true,
                "valueExpr": "id",
                "displayExpr": "description"
              }
            },
            "colorizer": {
              "styleProps": [
                {}
              ]
            }
          }
        },
        "status": {
          "$ref": "#/$defs/NetworkPumpStatus",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxSelectBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Статус сетевого насоса"
              },
              "editorOptions": {
                "readOnly": true,
                "valueExpr": "id",
                "displayExpr": "description"
              }
            },
            "colorizer": {
              "styleProps": [
                {}
              ]
            }
          }
        },
        "mode": {
          "$ref": "#/$defs/NetworkPumpMode",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxSelectBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Режим управления сетевым насосом"
              },
              "editorOptions": {
                "readOnly": true,
                "valueExpr": "id",
                "displayExpr": "description"
              }
            },
            "colorizer": {
              "styleProps": [
                {}
              ]
            }
          }
        },
        "isDryRun": {
          "type": "boolean",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Сухой ход"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "red": true,
                    "white": false
                  }
                }
              ]
            }
          }
        },
        "isAlarm": {
          "type": "boolean",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "red": true,
                    "white": false
                  }
                }
              ]
            }
          }
        }
      },
      "required": [
        "state",
        "isDryRun",
        "isAlarm"
      ]
    }
  },
  "ui": {
    "useTabs": true,
    "groups": [
      {
        "id": 1,
        "name": "state",
        "caption": "Состояния",
        "order": 100
      },
      {
        "id": 2,
        "name": "boilers",
        "caption": "Котлы",
        "order": 200
      },
      {
        "id": 3,
        "name": "networkPumps",
        "caption": "Сетевые насосы",
        "order": 300
      },
      {
        "id": 4,
        "name": "sourceWaterPumps",
        "caption": "Насосы исходной воды",
        "order": 400
      },
      {
        "id": 5,
        "name": "boilerPumps",
        "caption": "Насосы котлов",
        "order": 450
      },
      {
        "id": 6,
        "name": "valves",
        "caption": "Задвижки",
        "order": 500
      },
      {
        "id": 7,
        "name": "emergency",
        "caption": "Аварии",
        "order": 150
      },
      {
        "id": 8,
        "name": "gasMeter",
        "caption": "Газовый счетчик",
        "order": 160
      }
    ]
  }
}