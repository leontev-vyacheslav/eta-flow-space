{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateModel",
  "type": "object",
  "properties": {
    "isConnected": {
      "type": "boolean",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxCheckBox",
          "editorOptions": {
            "type": "boolean",
            "readOnly": true
          },
          "label": {
            "location": "left",
            "showColon": true,
            "text": "На связи"
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": false,
                "white": true
              },
              "stroke": {
                "yellow": false,
                "black": true
              }
            }
          ]
        }
      }
    },
    "tempOutAir": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура наружная"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "tempInNet": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура на подаче сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressInNet": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление на подаче сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "tempOutNet": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура на обратке сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressOutNet": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление на обратке сетевого контура"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "isCO": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Загазованность CO"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isCH": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Загазованность CH"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isSecurityAlarm": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Охранная сигнализация"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isFireAlarm": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Пожарная сигнализация"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isAlarmThreeWayValve": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Авария 3-х ходового клапана"
          },
          "editorOptions": {
            "readOnly": true
          }
        }
      }
    },
    "isAlarmStopAsmNetworkPumps": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "\"Аварийный стоп\" АСУ сетевых насосов"
          },
          "editorOptions": {
            "readOnly": true
          }
        }
      }
    },
    "isAlarmAsmNetworkPumps": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Авария АСУ сетевых насосов"
          },
          "editorOptions": {
            "readOnly": true
          }
        }
      }
    },
    "isWorkingAsmNetworkPumps": {
      "type": "boolean",
      "ui": {
        "group": 3,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Работа АСУ сетевых насосов"
          },
          "editorOptions": {
            "readOnly": true
          }
        }
      }
    },
    "threewayValve": {
      "$ref": "#/$defs/ThreeWayValveModel"
    },
    "sensors": {
      "$ref": "#/$defs/SensorsModel"
    },
    "sourceWaterPumps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceWaterPumpModel"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "boilers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoilerModel"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "boilerPumps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoilerPumpModel"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "networkPumps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetworkPumpModel"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "timestamp": {
      "type": "integer",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxDateBox",
          "editorOptions": {
            "type": "datetime",
            "displayFormat": "dd.MM.yyyy HH:mm:ss",
            "readOnly": true
          },
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Время опроса"
          }
        }
      }
    }
  },
  "required": [
    "isConnected",
    "tempOutAir",
    "tempInNet",
    "pressInNet",
    "tempOutNet",
    "pressOutNet",
    "isCO",
    "isCH",
    "isSecurityAlarm",
    "isFireAlarm",
    "isAlarmThreeWayValve",
    "isAlarmStopAsmNetworkPumps",
    "isAlarmAsmNetworkPumps",
    "isWorkingAsmNetworkPumps",
    "threewayValve",
    "sensors",
    "sourceWaterPumps",
    "boilers",
    "boilerPumps",
    "networkPumps"
  ],
  "$defs": {
    "NetworkPumpState": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "enumDescriptions": {
        "0": "STOP - Останов",
        "1": "WORKING - Работа"
      }
    },
    "NetworkPumpStatus": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "enumDescriptions": {
        "0": "RESERVED - Резервный",
        "1": "MAIN - Ocновной"
      }
    },
    "NetworkPumpMode": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "enumDescriptions": {
        "0": "MANUAL - Ручной",
        "1": "AUTO - Автоматический"
      }
    },
    "ThreeWayValveStatus": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ],
      "enumDescriptions": {
        "0": "INTERMEDIATE - Промежуточное",
        "1": "CLOSED - Закрыт",
        "2": "OPEN - Открыт"
      }
    },
    "ThreeWayValveModel": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/ThreeWayValveStatus",
          "ui": {
            "group": 6,
            "editor": {
              "editorType": "dxSelectBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Состояние 3-х ходового клапана"
              },
              "editorOptions": {
                "readOnly": true,
                "valueExpr": "id",
                "displayExpr": "description"
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "white": [
                      2
                    ],
                    "#808080": [
                      0,
                      1
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "required": [
        "status"
      ]
    },
    "SourceWaterPumpModel": {
      "type": "object",
      "properties": {
        "isWorking": {
          "type": "boolean",
          "ui": {
            "group": 4,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Работа насоса исходной воды"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "#00FF00": true,
                    "white": false
                  }
                }
              ]
            }
          }
        },
        "isAlarm": {
          "type": "boolean",
          "ui": {
            "group": 4,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария насоса исходной воды"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "stroke-width": {
                    "1": false,
                    "2  ": true
                  }
                },
                {
                  "stroke": {
                    "red": true,
                    "#000000": false
                  }
                }
              ]
            }
          }
        }
      }
    },
    "BoilerModel": {
      "type": "object",
      "properties": {
        "isBurnerFailure": {
          "type": "boolean",
          "ui": {
            "group": 2,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария горелки"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "stroke": {
                    "red": true,
                    "#000000": false
                  }
                }
              ]
            }
          }
        },
        "isWorking": {
          "type": "boolean",
          "ui": {
            "group": 2,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Работа котла"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "#00FF00": true,
                    "white": false
                  }
                }
              ]
            }
          }
        }
      },
      "required": [
        "state",
        "tempOut",
        "tempFlueGases",
        "isBurnerFailure",
        "isWorking",
        "isGasRelayPressure",
        "isMinWaterPressure",
        "isMaxWaterPressure",
        "isMaxWaterTemperature",
        "isFlowRelay",
        "statusTempOutSensor",
        "statusTempFlueGasesSensor"
      ]
    },
    "BoilerPumpModel": {
      "type": "object",
      "properties": {
        "isFailure": {
          "type": "boolean",
          "ui": {
            "group": 5,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Авария насоса котла"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "stroke-width": {
                    "1": false,
                    "2": true
                  }
                },
                {
                  "stroke": {
                    "red": true,
                    "#000000": false
                  }
                }
              ]
            }
          }
        }
      },
      "required": [
        "isFailure"
      ]
    },
    "NetworkPumpModel": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/NetworkPumpState",
