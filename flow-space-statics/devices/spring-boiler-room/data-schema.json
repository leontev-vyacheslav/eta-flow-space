                  "fill": {
                    "red": true,
                    "white": false
                  }
                }
              ]
            }
          }
        },
        "current": {
          "type": "number",
          "unit": "А",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxNumberBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Ток сетевого насоса"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "chart": {}
          }
        },
        "frequency": {
          "type": "number",
          "unit": "Гц",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxNumberBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Частота сетевого насоса"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "chart": {}
          }
        },
        "operatingTime": {
          "type": "integer",
          "unit": "ч",
          "ui": {
            "group": 3,
            "editor": {
              "editorType": "dxNumberBox",
              "label": {
                "location": "top",
                "showColon": true,
                "text": "Наработка сетевого насоса"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "chart": {}
          }
        }
      },
      "required": [
        "state",
        "status",
        "mode",
        "isDryRun",
        "isAlarm",
        "current",
        "frequency",
        "operatingTime"
      ]
    },
