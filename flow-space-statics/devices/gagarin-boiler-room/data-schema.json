                "text": "Авария котла"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "red": true,
                    "white": false
                  }
                }
              ]
            }
          }
        },
        "isStartError": {
          "type": "boolean",
          "ui": {
            "group": 2,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
