{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateModel",
  "type": "object",
  "properties": {
    "isConnected": {
      "type": "boolean",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxCheckBox",
          "editorOptions": {
            "type": "boolean",
            "readOnly": true
          },
          "label": {
            "location": "left",
            "showColon": true,
            "text": "На связи"
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": false,
                "white": true
              },
              "stroke": {
                "yellow": false,
                "black": true
              }
            }
          ]
        }
      }
    },
    "tempOutAir": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура наружного воздуха (TE1)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "tempOutNet": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура на подаче сетевого контура (TE2)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "tempInNet": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Температура на обратке сетевого контура (TE3)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressOutNet": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление на подаче сетевого контура (PE1)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "pressInNet": {
      "type": "number",
      "unit": "бар",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Давление на обратке сетевого контура (PE2)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "boilerRoomState": {
      "$ref": "#/$defs/BoilerRoomState",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxSelectBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Состояние котельной"
          },
          "editorOptions": {
            "readOnly": true,
            "valueExpr": "id",
            "displayExpr": "description"
          }
        }
      }
    },
    "tempOutNetSetpoint": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 10,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Задание температуры подачи по наружному воздуху (Тек. зад. ТЕ_С)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "tempBoilersSetpoint": {
      "type": "number",
      "unit": "°C",
      "ui": {
        "group": 10,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Текущее задание температуры воды после котлов (Тек. зад. ТЕ_К)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "chart": {}
      }
    },
    "cascadeStageOnIntegral": {
      "type": "number",
      "ui": {
        "group": 10,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Текущее значение интеграла включения ступени"
          },
          "editorOptions": {
            "readOnly": true
          }
        }
      }
    },
    "cascadeStageOffIntegral": {
      "type": "number",
      "ui": {
        "group": 10,
        "editor": {
          "editorType": "dxNumberBox",
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Текущее значение интеграла отключения ступени"
          },
          "editorOptions": {
            "readOnly": true
          }
        }
      }
    },
    "isCO": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Загазованность CO"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isCH": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Загазованность CH4"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isFireAlarm": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Пожар"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isDoorAlarm": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Охрана (дверь)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isSecurityAlarm": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Охрана (БСУ)"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isBatteryLow": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Батарея разряжена"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "isBatteryFault": {
      "type": "boolean",
      "ui": {
        "group": 7,
        "editor": {
          "editorType": "dxCheckBox",
          "label": {
            "location": "left",
            "showColon": true,
            "text": "Батарея неисправна"
          },
          "editorOptions": {
            "readOnly": true
          }
        },
        "colorizer": {
          "styleProps": [
            {
              "fill": {
                "red": true,
                "white": false
              }
            }
          ]
        }
      }
    },
    "sensors": {
      "$ref": "#/$defs/SensorsModel"
    },
    "boilers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoilerModel"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "networkPumps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetworkPumpModel"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "timestamp": {
      "type": "integer",
      "ui": {
        "group": 1,
        "editor": {
          "editorType": "dxDateBox",
          "editorOptions": {
            "type": "datetime",
            "displayFormat": "dd.MM.yyyy HH:mm:ss",
            "readOnly": true
          },
          "label": {
            "location": "top",
            "showColon": true,
            "text": "Время опроса"
          }
        }
      }
    }
  },
  "required": [
    "isConnected",
    "tempOutAir",
    "tempOutNet",
    "tempInNet",
    "pressOutNet",
    "pressInNet",
    "boilerRoomState",
    "tempOutNetSetpoint",
    "tempBoilersSetpoint",
    "cascadeStageOnIntegral",
    "cascadeStageOffIntegral",
    "isCO",
    "isCH",
    "isFireAlarm",
    "isDoorAlarm",
    "isSecurityAlarm",
    "isBatteryLow",
    "isBatteryFault",
    "sensors",
    "boilers",
    "networkPumps"
  ],
  "$defs": {
    "BoilerRoomState": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "enumDescriptions": {
        "0": "INITIAL - Исходное",
        "1": "BOILER_STARTING - Запуск котла",
        "2": "BOILER_STOPPING - Останов котла",
        "3": "OPERATION - Работа"
      }
    },
    "SensorsModel": {
      "type": "object",
      "properties": {
        "isTempOutAirSensorError": {
          "type": "boolean",
