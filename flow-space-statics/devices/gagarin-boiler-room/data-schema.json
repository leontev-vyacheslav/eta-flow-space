    "BoilerModel": {
      "type": "object",
      "properties": {
        "isWorking": {
          "type": "boolean",
          "ui": {
            "group": 2,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Работа котла"
              },
              "editorOptions": {
                "readOnly": true
              }
            },
            "colorizer": {
              "styleProps": [
                {
                  "fill": {
                    "#00FF00": true,
                    "white": false
                  }
                }
              ]
            }
          }
        },
        "isNormal": {
          "type": "boolean",
          "ui": {
            "group": 2,
            "editor": {
              "editorType": "dxCheckBox",
              "label": {
                "location": "left",
                "showColon": true,
                "text": "Котел в норме"
              },
              "editorOptions": {
                "readOnly": true
              }
            }
          }
        },
        "isLocked": {
          "type": "boolean",
