# Copy to sync-cert.env (not committed) and fill in.
# IIS server where win-acme exports the eta24.ru certificate as PEM files
CERT_SOURCE_HOST=192.168.1.10
# Windows user the Linux machine connects as over SSH (key-based, no password prompt)
CERT_SOURCE_USER=eta-leo
# win-acme "PEM encoded files" folder, forward slashes
CERT_SOURCE_DIR=C:/certs/eta24
# Optional
# CERT_HOSTNAME=eta24.ru
# GATEWAY_CONTAINER=eta-flow-space-gateway
