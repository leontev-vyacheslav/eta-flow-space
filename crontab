# min hour day month weekday command
# pg_dump and psql take the password from PGPASSWORD, set in .env-backup (see docker-compose.yaml)
0 0 * * * pg_dump -h eta-flow-space-database -U postgres -d eta_flow_space_database -F c -f /backups/eta_flow_space_database_$(date +%Y%m%d_%H%M%S).dump && ls -t /backups/*.dump | tail -n +5 | xargs rm -f
0 6 * * * pg_dump -h eta-flow-space-database -U postgres -d eta_flow_space_database -F c -f /backups/eta_flow_space_database_$(date +%Y%m%d_%H%M%S).dump && ls -t /backups/*.dump | tail -n +5 | xargs rm -f

0 5 * * * /cleanup.sh